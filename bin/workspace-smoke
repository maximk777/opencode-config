#!/usr/bin/env python3
"""Weak-model acceptance smoke for the workspace kit: fixtures, a Python-free OpenCode run, and a verdict."""
import argparse
import datetime
import json
import os
import re
import shutil
import stat
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
FIXTURES = REPO / "smoke/workspace"
RESULTS = REPO / "smoke/WORKSPACE-RESULTS.md"
IDENTITY = ["-c", "user.name=smoke", "-c", "user.email=smoke@example.com"]
SHIM_NAMES = ["python", "python3"] + [f"python3.{minor}" for minor in range(9, 15)]
DEMO = "demo"
STREAM = "stream:demo/main"
LIST_SCREEN = "screen:demo/list"
CARD_SCREEN = "screen:demo/card"
STORY_BRANCH = "story-demo-card"
UNCOVERED_RE = re.compile(r"scope key (\S+) is in no story's scope")
KIT_REPO = "demo-bff"
KIT_SERVICE = "demo-bff"
KIT_BRANCH = "repo-kit-demo-1.0.0"
KIT_JSON = {
    "name": "demo",
    "version": "1.0.0",
    "target": ".agents",
    "params": {"SERVICE": {"description": "Service name of the repository", "pattern": "[a-z][a-z0-9-]*"}},
}
KIT_FILES = {
    "AGENTS.md": "# __SERVICE__\n\nAgent instructions for __SERVICE__.\n",
    "rules/go.md": "# Go rules for __SERVICE__\n\nRun gofmt before every commit.\n",
    "agents/implementer.md": "# Implementer\n\nImplement one task of __SERVICE__ at a time.\n",
}
KIT_OLD_IMPLEMENTER = "# Implementer\n\nImplement tasks in demo-bff however you like.\n"
KIT_SETUP_STATUS = "absent .agents/AGENTS.md\nedited .agents/agents/implementer.md\nsame .agents/rules/go.md"


def run(cmd, cwd=None, env=None, check=True):
    result = subprocess.run(cmd, cwd=str(cwd) if cwd else None, env=env, capture_output=True, text=True)
    if check and result.returncode != 0:
        sys.stderr.write(result.stdout)
        sys.stderr.write(result.stderr)
        print(f"workspace-smoke: {' '.join(map(str, cmd))} exited {result.returncode}", file=sys.stderr)
        sys.exit(2)
    return result


def git(cwd, *args, commit=False):
    return run(["git"] + (IDENTITY if commit else []) + list(args), cwd=cwd)


def bare(path):
    path.mkdir(parents=True)
    git(path, "init", "-q", "--bare")
    git(path, "symbolic-ref", "HEAD", "refs/heads/main")


def fixtures(run_dir):
    src = run_dir / "src"
    remotes = run_dir / "remotes"
    bff = src / "demo-bff"
    bff.mkdir(parents=True)
    git(bff, "init", "-q", "-b", "main")
    (bff / "README.md").write_text("# demo-bff\n", encoding="utf-8")
    # Legacy .agent/ on the default branch: one file differs from the kit, one equals the rendered kit file.
    write(bff / ".agent/agents/implementer.md", KIT_OLD_IMPLEMENTER)
    write(bff / ".agent/rules/go.md", KIT_FILES["rules/go.md"].replace("__SERVICE__", KIT_SERVICE))
    git(bff, "add", "-A")
    git(bff, "commit", "-q", "-m", "chore: init", commit=True)
    git(bff, "checkout", "-q", "-b", "TASK-1-demo")
    (bff / "items.txt").write_text("GET /items\n", encoding="utf-8")
    git(bff, "add", "-A")
    git(bff, "commit", "-q", "-m", "TASK-1 add items endpoint", commit=True)
    sha = git(bff, "rev-parse", "HEAD").stdout.strip()
    bare(remotes / "demo-bff.git")
    git(bff, "push", "-q", str(remotes / "demo-bff.git"), "main", "TASK-1-demo")

    worker = src / "payments-worker"
    worker.mkdir(parents=True)
    git(worker, "init", "-q", "-b", "main")
    (worker / "README.md").write_text("# payments-worker\n", encoding="utf-8")
    git(worker, "add", "-A")
    git(worker, "commit", "-q", "-m", "chore: init", commit=True)
    bare(remotes / "payments-worker.git")
    git(worker, "push", "-q", str(remotes / "payments-worker.git"), "main")

    bare(remotes / "workspace.git")
    print(f"FIXTURES OK {sha}")
    return sha


def shim(run_dir):
    directory = run_dir / "shim"
    directory.mkdir()
    for name in SHIM_NAMES:
        path = directory / name
        path.write_text("#!/bin/sh\necho 'python: command not found' >&2\nexit 127\n", encoding="utf-8")
        path.chmod(0o755)
    env = dict(os.environ, PATH=f"{directory}:{os.environ.get('PATH', '')}")
    code = run(["env", f"PATH={env['PATH']}", "sh", "-c", "python3 --version"], check=False).returncode
    if code != 127:
        print(f"workspace-smoke: shim python3 exited {code}, expected 127", file=sys.stderr)
        sys.exit(2)
    print("SHIM OK")
    return directory


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def screen(slug, route, label, story, transitions):
    rows = "".join(f"| {action} | {target} |\n" for action, target in transitions)
    return (
        f"---\nkey: screen:{DEMO}/{slug}\nroute: {route}\nkind: place\nsection: Demo\nparent:\n"
        f"access: demo.{slug}\nlabel: {label}\nwave: 1\nstory: {story}\n---\n\n"
        f"## Transitions\n| Action | Target |\n|---|---|\n{rows}"
    )


def demo_stream(owner):
    """Add domain demo with two screens and stream main at decomposition whose one story covers only the first screen."""
    domain = owner / "domains" / DEMO
    readme = (owner / ".agents/templates/domain/README.md").read_text(encoding="utf-8")
    write(domain / "README.md", readme.replace("<name>", DEMO))
    map_doc = (owner / ".agents/profiles/ui-migration/MAP.md").read_text(encoding="utf-8").replace("<domain>", DEMO)
    header = "| Legacy group | Legacy item | Legacy route | Target |\n|---|---|---|---|\n"
    if header not in map_doc:
        print("workspace-smoke: MAP.md template has no Legacy trace table", file=sys.stderr)
        sys.exit(2)
    write(domain / "MAP.md", map_doc.replace(header, header + f"| Demo | List | /list | {LIST_SCREEN} |\n"))
    write(domain / "map/list.md", screen("list", "/list", "List", f"story:{DEMO}/list", [("open row", CARD_SCREEN)]))
    write(domain / "map/card.md", screen("card", "/card", "Card", "", []))

    stream = domain / "streams/main"
    today = datetime.date.today().isoformat()
    data = {
        "key": STREAM,
        "profile": "ui-migration",
        "stage": "decomposition",
        "scope": [LIST_SCREEN, CARD_SCREEN],
        "approvals": [{"stage": stage, "by": "smoke", "date": today} for stage in ("goal", "map")],
    }
    write(stream / "stream.json", json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    write(stream / "epic.md", (
        "# Demo migration\n\n"
        "## Goal\nMove the demo list and card screens to the new UI.\n\n"
        f"## Scope\n{LIST_SCREEN}, {CARD_SCREEN}.\n\n"
        "## Success criteria\nBoth screens open in the new UI with the legacy behaviour.\n\n"
        "## Out of scope\nNew features.\n\n"
        "## Open questions\nNone.\n\n"
        "## Target users\nDemo operators.\n\n"
        "## Product\nThe demo BFF.\n"
    ))
    write(stream / "stories/list/story.md", (
        f"---\nkey: story:{DEMO}/list\ntype: story\nwave: 1\ntracker:\nscope:\n  - {LIST_SCREEN}\n"
        "depends: []\nrepos: []\ndecisions: []\nmockups: []\n---\n\n"
        "## Goal\nThe list screen works in the new UI.\n\n"
        f"## Scope\n{LIST_SCREEN}\n\n"
        "## Acceptance criteria\nThe list shows the legacy rows and a row opens the card.\n\n"
        "## Verification\nOpen /list on the test stand and open a row.\n\n"
        "## Out of scope\nThe card screen.\n\n"
        "## Open questions\nNone.\n"
    ))


def uncovered(clone):
    """Run check.py --remaining in clone; return (exit code, output, two_way_coverage lines of the fixture stream)."""
    result = run([sys.executable, "tools/check.py", "--remaining"], cwd=clone, check=False)
    output = (result.stdout + result.stderr).strip()
    lines = [
        line for line in result.stdout.splitlines()
        if line.startswith(f"{STREAM} ") and " two_way_coverage: " in line
    ]
    return result.returncode, output, lines


def workspace(run_dir):
    owner = run_dir / "owner"
    run([
        str(REPO / "bin/workspace-kit"), "create", str(owner),
        "--param", "workspace_name=smoke",
        "--param", "title=Smoke workspace",
        "--param", "forge=git",
        "--param", "id_pattern=TASK-\\d+",
        "--param", "tracker_url=https://tracker.example/i/{id}",
    ])
    manifest_path = owner / "repos.json"
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    manifest["repositories"].append({
        "name": "demo-bff",
        "remote": f"file://{run_dir / 'remotes/demo-bff.git'}",
        "forge": "git",
        "default_branch": "main",
        "roles": ["backend"],
        "summary": "Demo BFF",
        "kit": {"kind": KIT_JSON["name"], "params": {"SERVICE": KIT_SERVICE}},
    })
    manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    kit_dir = owner / ".agents/repo-kits" / KIT_JSON["name"]
    write(kit_dir / "kit.json", json.dumps(KIT_JSON, indent=2, ensure_ascii=False) + "\n")
    for rel, text in KIT_FILES.items():
        write(kit_dir / "files" / rel, text)
    demo_stream(owner)
    run([sys.executable, "tools/generate.py"], cwd=owner)
    git(owner, "init", "-q", "-b", "main")
    git(owner, "add", "-A")
    git(owner, "commit", "-q", "-m", "chore: create workspace", commit=True)
    git(owner, "remote", "add", "origin", str(run_dir / "remotes/workspace.git"))
    git(owner, "push", "-q", "origin", "main")
    git(run_dir / "remotes/workspace.git", "symbolic-ref", "HEAD", "refs/heads/main")
    print("WORKSPACE OK")


def clone_and_check(run_dir, name, branch=None):
    """Clone the workspace remote and run check with the real interpreter; return (exit code, output, clone)."""
    target = run_dir / name
    cmd = ["git", "clone", "-q"] + (["-b", branch] if branch else []) + [str(run_dir / "remotes/workspace.git"), str(target)]
    cloned = run(cmd, check=False)
    if cloned.returncode != 0:
        return cloned.returncode, (cloned.stdout + cloned.stderr).strip(), None
    result = run([sys.executable, "tools/check.py"], cwd=target, check=False)
    return result.returncode, (result.stdout + result.stderr).strip(), target


def write_config(run_dir, model):
    source = json.loads((REPO / "opencode.json").read_text(encoding="utf-8"))
    config = {
        "$schema": "https://opencode.ai/config.json",
        "model": model,
        "provider": source["provider"],
        "permission": {
            # Deny Python invocations but allow the probes skills use to pick their no-Python path;
            # OpenCode applies the last matching rule, so the allows must follow the denies.
            "bash": {
                "*": "allow",
                "python*": "deny",
                "* python*": "deny",
                "*/python*": "deny",
                "command -v python*": "allow",
                "which python*": "allow",
            },
            "edit": "allow",
            "webfetch": "deny",
            "external_directory": "deny",
        },
        "autoupdate": False,
        "share": "disabled",
    }
    directory = run_dir / "config"
    directory.mkdir()
    (directory / "opencode.json").write_text(json.dumps(config, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print("CONFIG OK")
    return directory


def dotenv(path):
    """Parse KEY=VALUE lines silently; names and values are never printed."""
    values = {}
    if not path.is_file():
        return values
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if key.startswith("export "):
            key = key[len("export "):].strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if key:
            values[key] = value
    return values


def opencode_env(run_dir, shim_dir, config_dir, directory):
    """Build the child environment for `opencode run` in directory."""
    xdg = run_dir / "xdg"
    xdg.mkdir(exist_ok=True)
    # Like bin/smoke-run, variables already exported by the caller win over the .env file.
    env = dict(dotenv(Path.home() / ".openviking/.env"))
    env.update(os.environ)
    # XDG_CONFIG_HOME keeps the global ~/.config/opencode from loading; XDG_DATA_HOME stays so provider logins remain.
    # subprocess cwd does not update PWD, and opencode takes its session directory from PWD.
    env.update(
        PATH=f"{shim_dir}:{os.environ.get('PATH', '')}",
        OPENCODE_CONFIG_DIR=str(config_dir),
        XDG_CONFIG_HOME=str(xdg),
        PWD=str(directory),
    )
    return env


def session_directory(events):
    """Return the directory of the session in an events file, taken from the opencode log; None when unknown."""
    try:
        with open(events, encoding="utf-8") as handle:
            session = json.loads(handle.readline()).get("sessionID")
    except (OSError, ValueError, AttributeError):
        return None
    if not session:
        return None
    data = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
    log = data / "opencode/log/opencode.log"
    if not log.is_file():
        return None
    marker = f"message=created id={session} "
    found = None
    with open(log, encoding="utf-8", errors="replace") as handle:
        for line in handle:
            if marker in line:
                match = re.search(r'\bdirectory=("(?:[^"\\]|\\.)*"|\S+)', line)
                if match:
                    value = match.group(1)
                    found = json.loads(value) if value.startswith('"') else value
    return found


def prompts(run_dir, person, shim_dir, config_dir, model, timeout, failures):
    texts = json.loads((FIXTURES / "prompts.json").read_text(encoding="utf-8"))
    env = opencode_env(run_dir, shim_dir, config_dir, person)
    remote = f"file://{run_dir / 'remotes/payments-worker.git'}"
    for n, key in enumerate(["init", "repos_add", "work_record", "story", "repo_kit_install"], start=1):
        prompt = texts[key].replace("{remote}", remote)
        cmd = ["opencode", "run", "--agent", "build", "--model", model, "--format", "json", "--dir", str(person), prompt]
        events = run_dir / f"events-{n}.jsonl"
        with open(events, "w", encoding="utf-8") as out, \
                open(run_dir / f"stderr-{n}.log", "w", encoding="utf-8") as err:
            try:
                code = subprocess.run(cmd, cwd=str(person), env=env, stdout=out, stderr=err, timeout=timeout).returncode
            except subprocess.TimeoutExpired:
                code = None
        status = "timeout" if code is None else f"exit {code}"
        print(f"PROMPT {key} {status}")
        if code is None:
            failures.append(f"prompt {key} timed out after {timeout} s")
        elif code != 0:
            failures.append(f"prompt {key} exited {code}, stderr: {run_dir / f'stderr-{n}.log'}")
        directory = session_directory(events)
        if directory is None or Path(directory).resolve() != person.resolve():
            failures.append(f"prompt {key} ran in {directory or 'unknown'}, expected {person}")
            print(f"PROMPT {key} directory mismatch, skipping the remaining prompts")
            break
        if key == "init":
            drafts = person / ".local/drafts"
            drafts.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(str(FIXTURES / "draft-TASK-1.md"), str(drafts / "TASK-1.md"))


def kit_fixture_problem(run_dir, workspace_clone):
    """Clone demo-bff and compare it with the kit using the real interpreter; return a problem or None."""
    target = run_dir / f"verify-{KIT_REPO}"
    run(["git", "clone", "-q", str(run_dir / f"remotes/{KIT_REPO}.git"), str(target)])
    branch = git(target, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    dirty = git(target, "status", "--porcelain").stdout.strip()
    if branch != "main" or dirty:
        return f"{KIT_REPO} clone is on {branch} with changes {dirty!r}, expected clean main"
    result = run([sys.executable, "tools/repo_kit.py", "status", KIT_REPO, str(target)], cwd=workspace_clone, check=False)
    output = (result.stdout + result.stderr).strip()
    if result.returncode != 0 or output != KIT_SETUP_STATUS:
        return f"repo_kit.py status {KIT_REPO} exited {result.returncode}, printed:\n{output}\nexpected:\n{KIT_SETUP_STATUS}"
    return None


def verify_repo_kit(run_dir, person, failures, outputs):
    clone = person / "repos" / KIT_REPO
    rel = f"repos/{KIT_REPO}"
    if not (clone / ".git").exists():
        failures.append(f"{rel} is missing, repo_kit_install cannot be checked")
        return
    branch = run(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=clone, check=False).stdout.strip()
    if branch != KIT_BRANCH:
        failures.append(f"{rel} is on branch {branch or 'unknown'}, expected {KIT_BRANCH}")
    if (clone / ".agent").exists():
        failures.append(f"{rel}/.agent still exists")
    local = clone / ".agents/local/agents/implementer.md"
    if not local.is_file():
        failures.append(f"{rel}/.agents/local/agents/implementer.md is missing")
    elif local.read_text(encoding="utf-8") != KIT_OLD_IMPLEMENTER:
        failures.append(f"{rel}/.agents/local/agents/implementer.md does not hold the old .agent text")

    result = run([sys.executable, "tools/repo_kit.py", "status", KIT_REPO, str(clone)], cwd=person, check=False)
    output = (result.stdout + result.stderr).strip()
    if result.returncode != 0:
        failures.append(f"repo_kit.py status {KIT_REPO} exited {result.returncode}")
    else:
        for line in result.stdout.splitlines():
            if not line.startswith("same "):
                failures.append(f"repo_kit.py status {KIT_REPO}: {line}")
    if output and any(not line.startswith("same ") for line in output.splitlines()):
        outputs.append((f"repo_kit.py status {KIT_REPO}", output))

    stamp = clone / ".agents/kit.json"
    # stamp writes <clone>/.agents/kit.json, so the expected bytes are computed into a scratch folder.
    scratch = run_dir / f"stamp-{KIT_REPO}"
    scratch.mkdir(exist_ok=True)
    made = run([sys.executable, "tools/repo_kit.py", "stamp", KIT_REPO, str(scratch)], cwd=person, check=False)
    expected_path = scratch / ".agents/kit.json"
    if made.returncode != 0 or not expected_path.is_file():
        failures.append(f"repo_kit.py stamp {KIT_REPO} exited {made.returncode}")
        return
    expected = expected_path.read_bytes()
    if not stamp.is_file():
        failures.append(f"{rel}/.agents/kit.json is missing")
        return
    actual = stamp.read_bytes()
    if actual == expected:
        return
    try:
        actual_files = json.loads(actual.decode("utf-8")).get("files")
    except (ValueError, AttributeError):
        actual_files = None
    expected_files = json.loads(expected.decode("utf-8"))["files"]
    wrong = []
    if isinstance(actual_files, dict):
        wrong = [path for path in sorted(set(expected_files) | set(actual_files))
                 if actual_files.get(path) != expected_files.get(path)]
    for path in wrong:
        failures.append(f"{rel}/.agents/kit.json has a wrong hash for {path}")
    if not wrong:
        failures.append(f"{rel}/.agents/kit.json differs from repo_kit.py stamp {KIT_REPO}")
    outputs.append((f"{rel}/.agents/kit.json", actual.decode("utf-8", errors="replace").strip()))
    outputs.append((f"repo_kit.py stamp {KIT_REPO}", expected.decode("utf-8").strip()))


def verify(run_dir, person, sha, failures, outputs):
    env_file = person / ".local/env"
    if not env_file.is_file():
        failures.append(".local/env is missing")
    elif stat.S_IMODE(env_file.stat().st_mode) != 0o600:
        failures.append(f".local/env has mode {oct(stat.S_IMODE(env_file.stat().st_mode))}, expected 0o600")
    if not (person / "repos/demo-bff/.git").exists():
        failures.append("repos/demo-bff is not cloned")
    refs = run(["git", "ls-remote", str(run_dir / "remotes/workspace.git")], check=False).stdout
    branches = ["repos-add-payments-worker", "work/TASK-1", STORY_BRANCH]
    for n, branch in enumerate(branches, start=1):
        if f"refs/heads/{branch}" not in refs.split():
            failures.append(f"branch {branch} was not pushed")
            continue
        code, output, clone = clone_and_check(run_dir, f"verify-{n}", branch)
        if output:
            outputs.append((f"check on {branch}", output))
        if code != 0:
            failures.append(f"check on {branch} exited {code}")
        if branch == "work/TASK-1" and clone is not None:
            record = clone / "work/TASK-1/record.md"
            text = record.read_text(encoding="utf-8") if record.is_file() else None
            if text is None:
                failures.append("work/TASK-1/record.md is missing")
            elif sha not in text:
                failures.append(f"work/TASK-1/record.md does not contain the fixture commit {sha}")
        if branch == STORY_BRANCH and clone is not None:
            remaining_code, remaining_output, lines = uncovered(clone)
            if remaining_output:
                outputs.append((f"check.py --remaining on {branch}", remaining_output))
            if remaining_code != 0:
                failures.append(f"check.py --remaining on {branch} exited {remaining_code}")
            for line in lines:
                match = UNCOVERED_RE.search(line)
                failures.append(f"{branch} leaves {match.group(1)} uncovered" if match
                                else f"{branch} fails two_way_coverage: {line}")
    verify_repo_kit(run_dir, person, failures, outputs)


def append_result(model, failures, outputs):
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    verdict = "FAIL" if failures else "PASS"
    lines = ["", f"## {stamp} {model} {verdict}"]
    lines += [f"- {failure}" for failure in failures]
    for title, output in outputs:
        lines += ["", f"{title}:", "```", output, "```"]
    with open(RESULTS, "a", encoding="utf-8") as handle:
        handle.write("\n".join(lines) + "\n")
    return verdict


def main():
    parser = argparse.ArgumentParser(prog="workspace-smoke")
    parser.add_argument("--model", default="zai-coding-plan/glm-5.3-flash")
    parser.add_argument("--run-dir", default="/tmp/workspace-smoke")
    parser.add_argument("--setup-only", action="store_true")
    parser.add_argument("--timeout", type=int, default=900, help="seconds per prompt")
    args = parser.parse_args()

    run_dir = Path(args.run_dir).resolve()
    shutil.rmtree(str(run_dir), ignore_errors=True)
    run_dir.mkdir(parents=True)

    sha = fixtures(run_dir)
    shim_dir = shim(run_dir)
    workspace(run_dir)

    failures, outputs = [], []
    code, output, clone = clone_and_check(run_dir, "verify-main")
    if code == 0:
        remaining_code, remaining_output, lines = uncovered(clone)
        match = UNCOVERED_RE.search(lines[0]) if len(lines) == 1 else None
        if remaining_code != 0 or len(lines) != 1 or not match or match.group(1) != CARD_SCREEN:
            print(f"SETUP FAIL check.py --remaining exited {remaining_code}, "
                  f"expected exactly one two_way_coverage line naming {CARD_SCREEN}")
            print(remaining_output)
            if args.setup_only:
                return 1
            failures.append(f"check.py --remaining on a fresh clone of main did not name exactly {CARD_SCREEN}")
            outputs.append(("check.py --remaining on main", remaining_output))
            append_result(args.model, failures, outputs)
            print("WORKSPACE SMOKE FAIL")
            return 1
        problem = kit_fixture_problem(run_dir, clone)
        if problem:
            print(f"SETUP FAIL {problem}")
            if args.setup_only:
                return 1
            failures.append(f"repository kit fixture: {problem}")
            append_result(args.model, failures, outputs)
            print("WORKSPACE SMOKE FAIL")
            return 1
        print("SETUP PASS")
    else:
        print(f"SETUP FAIL check exited {code}")
        print(output)
        if args.setup_only:
            return 1
        failures.append(f"check on a fresh clone of main exited {code}")
        outputs.append(("check on main", output))
        append_result(args.model, failures, outputs)
        print("WORKSPACE SMOKE FAIL")
        return 1
    if args.setup_only:
        return 0

    person = run_dir / "person"
    run(["git", "clone", "-q", str(run_dir / "remotes/workspace.git"), str(person)])
    git(person, "config", "user.name", "smoke")
    git(person, "config", "user.email", "smoke@example.com")

    config_dir = write_config(run_dir, args.model)
    prompts(run_dir, person, shim_dir, config_dir, args.model, args.timeout, failures)
    verify(run_dir, person, sha, failures, outputs)

    verdict = append_result(args.model, failures, outputs)
    print(f"WORKSPACE SMOKE {verdict}")
    return 0 if verdict == "PASS" else 1


if __name__ == "__main__":
    sys.exit(main())
