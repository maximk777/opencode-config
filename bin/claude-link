#!/usr/bin/env python3
# Links this OpenCode setup into Claude Code: instructions, skills and commands by symlink, agents as generated files.
# Safe to rerun after changing the setup; it never overwrites files it did not create.
import fnmatch
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
MARK = "<!-- generated by ~/.config/opencode/bin/claude-link from opencode.json and prompts/; edit those and rerun -->"
MODELS = {"smart": "opus", "fast": "sonnet"}
# Claude Code scopes tools per agent, not per command, so read-only agents get a narrow tool list.
TOOLS = {"explorer": "Read, Grep, Glob, Bash", "task-reviewer": "Read, Grep, Glob, Bash, Edit"}
PLUGINS_OFF = ["magent@magent", "magent-lang@magent", "humanizer@humanizer"]
HOOK_COMMAND = "~/.config/opencode/bin/claude-change-context"
DENY = ["Read(~/.openviking/.env)", "Read(**/.env)", "Bash(printenv:*)", "Bash(env)", "Bash(opencode debug config:*)"]


OPENVIKING_READ_TOOLS = ("find", "search")


def permission_value(perm, key):
    """OpenCode semantics: the last entry in `perm` whose pattern (exact or glob) matches `key` wins."""
    value = None
    for pattern, v in perm.items():
        if isinstance(v, str) and fnmatch.fnmatchcase(key, pattern):
            value = v
    return value


def openviking_tools(spec):
    """openviking_<tool> permissions resolved to allow, sorted so the generated tools line is deterministic."""
    perm = spec.get("permission", {})
    exact = {m.group(1) for m in (re.fullmatch(r"openviking_(\w+)", k) for k in perm) if m}
    candidates = sorted(set(OPENVIKING_READ_TOOLS) | exact)
    return [t for t in candidates if permission_value(perm, f"openviking_{t}") == "allow"]


def agent_text(name, spec, prompt):
    tier = re.search(r"tiers/([a-z]+)", spec["model"]).group(1)
    front = ["---", f"name: {name}", f"description: {json.dumps(spec['description'])}", f"model: {MODELS[tier]}"]
    if name in TOOLS:
        tools = TOOLS[name].split(", ") + [f"mcp__openviking__{t}" for t in openviking_tools(spec)]
        front.append(f"tools: {', '.join(tools)}")
    return "\n".join(front + ["---", MARK, "", prompt.rstrip("\n"), ""])


def plan_links(repo, home):
    links = [(repo / "AGENTS.md", home / "CLAUDE.md")]
    links += [(d, home / "skills" / d.name) for d in sorted((repo / "skills").iterdir()) if (d / "SKILL.md").exists()]
    links += [(f, home / "commands" / f.name) for f in sorted((repo / "commands").glob("*.md"))]
    return links


def plan_agents(repo):
    cfg = json.loads((repo / "opencode.json").read_text())
    out = {}
    for name, spec in cfg["agent"].items():
        prompt = (repo / re.search(r"\{file:\./(.+)\}", spec["prompt"]).group(1)).read_text()
        out[name] = agent_text(name, spec, prompt)
    return out


def merge_settings(settings):
    plugins = settings.setdefault("enabledPlugins", {})
    for p in PLUGINS_OFF:
        if p in plugins:
            plugins[p] = False
    starts = settings.setdefault("hooks", {}).setdefault("SessionStart", [])
    if not any(h.get("command") == HOOK_COMMAND for m in starts for h in m.get("hooks", [])):
        starts.append({"matcher": "compact", "hooks": [{"type": "command", "command": HOOK_COMMAND}]})
    deny = settings.setdefault("permissions", {}).setdefault("deny", [])
    deny.extend(d for d in DENY if d not in deny)
    return settings


def apply(repo, home, dry_run=False):
    """Returns (done, refused) lists of human-readable lines."""
    done, refused = [], []
    for src, dst in plan_links(repo, home):
        if dst.is_symlink() and dst.resolve() == src.resolve():
            continue
        if dst.exists() or dst.is_symlink():
            refused.append(f"exists, not linked: {dst}")
            continue
        if not dry_run:
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.symlink_to(src)
        done.append(f"link {dst} -> {src}")
    for name, text in plan_agents(repo).items():
        dst = home / "agents" / f"{name}.md"
        if dst.exists() and MARK not in dst.read_text():
            refused.append(f"exists, not generated: {dst}")
            continue
        if dst.exists() and dst.read_text() == text:
            continue
        if not dry_run:
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.write_text(text)
        done.append(f"agent {dst}")
    path = home / "settings.json"
    current = json.loads(path.read_text()) if path.exists() else {}
    merged = merge_settings(json.loads(json.dumps(current)))
    if merged != current:
        if not dry_run:
            path.write_text(json.dumps(merged, indent=2, ensure_ascii=False) + "\n")
        done.append(f"settings {path}: plugins off, SessionStart hook, deny rules")
    return done, refused


def mcp_json(repo):
    return json.dumps({"type": "http", "url": "http://127.0.0.1:1933/mcp", "headersHelper": str(repo / "bin" / "ov-mcp-headers")})


def ensure_mcp(repo, dry_run=False):
    if not shutil.which("claude") or subprocess.run(["claude", "mcp", "get", "openviking"], capture_output=True).returncode == 0:
        return []
    if not dry_run:
        subprocess.run(["claude", "mcp", "add-json", "-s", "user", "openviking", mcp_json(repo)], check=True, capture_output=True)
    return ["mcp openviking (user scope, headersHelper)"]


if __name__ == "__main__":
    dry_run = "--dry-run" in sys.argv
    done, refused = apply(REPO, Path.home() / ".claude", dry_run=dry_run)
    done += ensure_mcp(REPO, dry_run)
    print("\n".join(done) or "claude-link: nothing to change")
    if refused:
        print("\n".join(refused), file=sys.stderr)
        sys.exit(1)
