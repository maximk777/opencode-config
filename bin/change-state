#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys
from pathlib import Path


VERDICT = re.compile(r"^Verdict: (NOT )?COMPLIANT\s*$", re.M)
ATTEMPT = re.compile(r"^## Attempt (\d+)", re.M)


def review_status(text):
    """Classifies one report: an attempt without its own verdict awaits review, otherwise the last verdict decides."""
    verdicts = list(VERDICT.finditer(text))
    # Counting instead of positions: executors sometimes rewrite the file and put the new attempt on top.
    attempts = max([1, *(int(n) for n in ATTEMPT.findall(text))])
    if attempts > len(verdicts):
        return "awaiting_review"
    return "needs_fix" if verdicts[-1].group(1) else "ready_to_accept"


def memory_fields(root, slug, home=None):
    """decisions.md path, synced_commit from the sync worker state, and HEAD of the specs repository."""
    home = Path(home) if home else Path.home()
    change = Path(root) / "openspec" / "changes" / slug
    decisions = change / "decisions.md"
    state_file = home / ".openviking" / "sync-state" / f"{Path(root).resolve().name}.json"
    synced_commit = None
    if state_file.exists():
        try:
            synced_commit = json.loads(state_file.read_text()).get("synced_commit")
        except Exception:
            synced_commit = None
    head = None
    try:
        r = subprocess.run(["git", "rev-parse", "HEAD"], cwd=root, capture_output=True, text=True)
        if r.returncode == 0:
            head = r.stdout.strip()
    except Exception:
        head = None
    return {
        "decisions": str(decisions.resolve()) if decisions.exists() else None,
        "synced_commit": synced_commit,
        "head": head,
    }


def read_state(root, slug, run_openspec=True, home=None):
    ch = Path(root) / "openspec" / "changes" / slug
    tasks = (ch / "tasks.md").read_text() if (ch / "tasks.md").exists() else ""
    done = re.findall(r"^- \[x\] (\d+(?:\.\d+)*)", tasks, re.M)
    open_ = re.findall(r"^- \[ \] (\d+(?:\.\d+)*)", tasks, re.M)
    groups = {"awaiting_review": [], "needs_fix": [], "ready_to_accept": []}
    for t in open_:
        rep = ch / "reports" / f"{t}.md"
        if rep.exists():
            groups[review_status(rep.read_text())].append(t)
    wave = None
    if (ch / "waves.md").exists():
        for line in (ch / "waves.md").read_text().splitlines():
            m = re.match(r"wave (\d+): (.*)", line)
            if m and any(t in open_ for t in m.group(2).split()):
                wave = int(m.group(1))
                break
    status = None
    if run_openspec:
        env = dict(os.environ, OPENSPEC_TELEMETRY="0")
        r = subprocess.run(["openspec", "status", "--change", slug, "--json"], cwd=root, capture_output=True, text=True, env=env)
        try:
            status = json.loads(r.stdout)
        except Exception:
            status = {"error": (r.stderr or r.stdout).strip().split("\n")[0]}
    return {
        "slug": slug,
        "tasks_total": len(done) + len(open_),
        "tasks_done": done,
        "tasks_open": open_,
        **groups,
        "current_wave": wave,
        "openspec_status": status,
        **memory_fields(root, slug, home=home),
    }


if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.exit("usage: change-state <specs-root> <slug>")
    print(json.dumps(read_state(sys.argv[1], sys.argv[2]), ensure_ascii=False, indent=2))
