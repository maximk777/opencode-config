#!/usr/bin/env python3
import json
import os
import string
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
HOME_DIR = Path.home() / ".openviking"


def read_env(path):
    env = {}
    for line in path.read_text().splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = line.split("=", 1)
            env[k.strip()] = v.strip()
    return env


def render_config(template_text, env):
    # Values land inside JSON string literals, so they are JSON-escaped and the result is parsed to fail before writing.
    escaped = {k: json.dumps(v)[1:-1] for k, v in env.items()}
    text = string.Template(template_text).substitute(escaped)
    json.loads(text)
    return text


def write_private(path, text):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        os.fchmod(fd, 0o600)
        f.write(text)


def main():
    env_file = HOME_DIR / ".env"
    if not env_file.exists():
        sys.exit("ov-up: ~/.openviking/.env is missing")
    conf = HOME_DIR / "ov.conf"
    write_private(conf, render_config((REPO / "openviking" / "ov.conf.template").read_text(), read_env(env_file)))
    subprocess.run(["ollama", "pull", "bge-m3"], check=True, stdout=subprocess.DEVNULL)
    subprocess.run(["docker", "compose", "-f", str(REPO / "openviking" / "docker-compose.yml"), "up", "-d"], check=True)
    print("ov-up: started")


if __name__ == "__main__":
    main()
