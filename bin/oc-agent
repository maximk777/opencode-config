#!/usr/bin/env python3
import json
import re
import subprocess
import sys


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: oc-agent <agent-name>")
    name = sys.argv[1]
    try:
        out = subprocess.run(["opencode", "debug", "agent", name], capture_output=True, text=True, timeout=60).stdout
    except subprocess.TimeoutExpired as e:
        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
    m = re.search(r"\{.*\}", out, re.S)
    if not m:
        print(f"agent={name} not-found")
        sys.exit(1)
    d = json.loads(m.group(0))
    model = d.get("model") or {}
    print(f"agent={d.get('name')} mode={d.get('mode')} model={model.get('providerID')}/{model.get('modelID')}")


if __name__ == "__main__":
    main()
