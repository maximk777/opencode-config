#!/usr/bin/env python3
# Prints the resolved model of one agent. OpenCode V2: `opencode debug agents`
# lists every agent as JSON and must run from a project directory.
import json
import subprocess
import sys


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: oc-agent <agent-name>   (run from a project directory)")
    name = sys.argv[1]
    try:
        out = subprocess.run(["opencode", "debug", "agents"], capture_output=True, text=True, timeout=60).stdout
    except subprocess.TimeoutExpired as e:
        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
    try:
        agents = json.loads(out)
    except json.JSONDecodeError:
        agents = []
    d = next((a for a in agents if isinstance(a, dict) and (a.get("id") == name or a.get("name") == name)), None)
    if not d:
        hint = "" if agents else " (no agents returned: run oc-agent from a project directory)"
        print(f"agent={name} not-found{hint}")
        sys.exit(1)
    model = d.get("model") or {}
    print(f"agent={d.get('name')} mode={d.get('mode')} model={model.get('providerID')}/{model.get('id')}")


if __name__ == "__main__":
    main()
