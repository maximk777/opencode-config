#!/usr/bin/env python3
import argparse
import collections
import re
import subprocess

FIX = re.compile(r"^fix(\(|:)|hotfix|bug|исправ", re.I)


def parse(log):
    commits, cur = [], None
    for line in log.splitlines():
        if re.match(r"^[0-9a-f]{7,40}\t", line):
            h, s = line.split("\t", 1)
            cur = {"hash": h, "subject": s, "files": []}
            commits.append(cur)
        elif line.strip() and cur is not None:
            cur["files"].append(line.strip())
    return commits


def summarize(commits, top=15):
    fixes = [c for c in commits if FIX.search(c["subject"])]
    reverts = [c for c in commits if c["subject"].startswith('Revert "')]
    fix_count, total = collections.Counter(), collections.Counter()
    for c in commits:
        total.update(set(c["files"]))
    for c in fixes:
        fix_count.update(set(c["files"]))
    hot = sorted(fix_count, key=lambda f: (-fix_count[f], -total[f], f))[:top]
    return fixes, reverts, [(f, fix_count[f], total[f]) for f in hot]


def render(name, commits):
    fixes, reverts, hot = summarize(commits)
    out = [
        f"# Error background: {name}",
        f"Fix commits: {len(fixes)}   Reverts: {len(reverts)}   Commits scanned: {len(commits)}",
        "## Hot files",
        "| File | Fix commits | Total commits |",
        "|---|---|---|",
    ]
    out += [f"| {f} | {n} | {t} |" for f, n, t in hot]
    out += ["## Fix commit subjects"] + [f"- {c['hash'][:8]} {c['subject']}" for c in fixes]
    return "\n".join(out)


if __name__ == "__main__":
    p = argparse.ArgumentParser(description="Measure a repository's error background from git history")
    p.add_argument("repo")
    p.add_argument("--since", default="180.days")
    a = p.parse_args()
    log = subprocess.run(
        ["git", "-C", a.repo, "log", f"--since={a.since}", "--name-only", "--pretty=format:%H%x09%s"],
        capture_output=True, text=True, check=True,
    ).stdout
    print(render(a.repo.rstrip("/").split("/")[-1], parse(log)))
