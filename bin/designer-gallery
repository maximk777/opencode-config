#!/usr/bin/env python3
"""Regenerate the mockup gallery from mockups.json and canvas.json."""
import html
import json
import re
import subprocess
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

USAGE = "usage: designer-gallery <mockups-dir> --map <MAP.md>"
HEADER = "<!-- generated by designer-gallery; do not edit -->"
VALIDATE = Path(__file__).resolve().parent / "designer-validate"
FSD_NAME = "fsd-design.md"
LANE_HEIGHT = 1000
# Same regex approach as designer-validate's reference extraction.
LINK_RES = re.compile(r"<a\b[^>]*\bhref=[\"']([^\"']+)[\"']")
SECTION_RES = re.compile(r"^Section:\s*(.+)$")


def parse_args(argv):
    mockups_dir = None
    map_path = None
    args = list(argv)
    while args:
        arg = args.pop(0)
        if arg == "--map" and args:
            map_path = args.pop(0)
        elif arg.startswith("--map="):
            map_path = arg.split("=", 1)[1]
        elif mockups_dir is None:
            mockups_dir = arg
        else:
            return None
    if mockups_dir is None or map_path is None:
        return None
    return Path(mockups_dir), Path(map_path)


def run_validation(mockups_dir, map_path):
    """Gate on designer-validate; returns (exit code, stderr text)."""
    proc = subprocess.run(
        [sys.executable, str(VALIDATE), str(mockups_dir), "--map", str(map_path)],
        capture_output=True,
        text=True,
    )
    return proc.returncode, proc.stderr


def render_index(canvas):
    lines = [
        HEADER,
        "<!doctype html>",
        '<html lang="en"><head><meta charset="utf-8"><title>Mockups</title>',
        "<style>body{font-family:sans-serif;margin:2rem}"
        ".card{margin:0.5rem 0;padding:0.5rem;border:1px solid #ccc}</style>",
        "</head><body>",
        "<h1>Mockups</h1>",
    ]
    # Deterministic order: feature, then y, then x, then file.
    artboards = sorted(
        canvas.get("artboards", []),
        key=lambda a: (a.get("feature", ""), a.get("y", 0), a.get("x", 0), a.get("file", "")),
    )
    for board in artboards:
        file = board.get("file", "")
        title = board.get("title") or file
        lines.append(
            f'<div class="card"><a href="{html.escape(file, quote=True)}">'
            f"{html.escape(title)}</a></div>"
        )
    lines.append("</body></html>")
    return "\n".join(lines) + "\n"


def render_mockups_md(manifest):
    lines = [HEADER, "# Mockups", ""]
    for key, entry in sorted(manifest.get("mockups", {}).items()):
        artboard = entry.get("artboard", "")
        screen = entry.get("screen", "")
        lines.append(f"- {key} -> {artboard}.dc.html (screen: {screen})")
    none_list = manifest.get("none", [])
    if none_list:
        lines += ["", "## Not mocked", ""]
        lines += [f"- {key}" for key in none_list]
    return "\n".join(lines) + "\n"


def render_feature_views(mockups_dir, canvas, resolved):
    """One feature/<slug>.html per feature: cards for its artboards linking the
    artboard files and ../index.html. Distinct feature names that slugify alike
    share one view instead of overwriting each other."""
    lanes = {}
    for item in resolved:
        lane = lanes.setdefault(slugify(item["feature"]), {"title": item["feature"], "items": []})
        lane["items"].append(item)
    views = {}
    for slug, lane in sorted(lanes.items()):
        feature = lane["title"]
        lines = [
            HEADER,
            "<!doctype html>",
            '<html lang="en"><head><meta charset="utf-8">'
            f"<title>Feature: {html.escape(feature)}</title>",
            "<style>body{font-family:sans-serif;margin:2rem}"
            ".card{margin:0.5rem 0;padding:0.5rem;border:1px solid #ccc}</style>",
            "</head><body>",
            f"<h1>Feature: {html.escape(feature)}</h1>",
            '<p><a href="../index.html">&larr; All mockups</a></p>',
        ]
        for item in sorted(lane["items"], key=lambda i: (i["artboard"], i["key"])):
            # Views live in feature/, so artboard hrefs must climb one level.
            file = f"../{item['artboard']}.dc.html"
            lines.append(
                f'<div class="card"><a href="{html.escape(file, quote=True)}">'
                f"{html.escape(item['artboard'])}</a></div>"
            )
        lines.append("</body></html>")
        views[f"feature/{slug}.html"] = "\n".join(lines) + "\n"
    return views


def slugify(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")


def resolve_feature(entry, fsd_map, screen_to_section):
    """Feature of a manifest entry: its `feature` field, else fsd-design.md,
    else the MAP section; screens in none of the three land in `misc`."""
    screen = entry.get("screen", "")
    return entry.get("feature") or fsd_map.get(screen) or screen_to_section.get(screen, "misc")


def parse_fsd(map_path):
    """Screen key -> feature from fsd-design.md next to the MAP (2-column table)."""
    fsd = {}
    try:
        lines = (map_path.parent / FSD_NAME).read_text(encoding="utf-8").splitlines()
    except OSError:
        return fsd
    for raw in lines:
        row = raw.strip()
        if not row.startswith("|"):
            continue
        cells = [cell.strip() for cell in row.strip("|").split("|")]
        if len(cells) == 2 and cells[0].startswith("screen:"):
            fsd[cells[0]] = cells[1]
    return fsd


def screen_sections(map_path):
    """Screen key -> enclosing `Section:` heading. Row acceptance is delegated
    to designer-validate.parse_map (the gate has already rejected malformed
    rows), so only accepted screen keys get a section."""
    dv = SourceFileLoader("designer_validate", str(VALIDATE)).load_module()
    keys = set(dv.parse_map(map_path, []))
    sections, current = {}, None
    for raw in Path(map_path).read_text(encoding="utf-8").splitlines():
        row = raw.strip()
        head = SECTION_RES.match(row)
        if head:
            current = head.group(1).strip()
            continue
        if row.startswith("|"):
            cells = [cell.strip() for cell in row.strip("|").split("|")]
            # A screen row above the first Section: heading has no section;
            # leave it unset so resolve_feature's "misc" default applies.
            if cells and cells[0] in keys and current is not None:
                sections[cells[0]] = current
    return sections


def resolved_entries(manifest, fsd_map, sections):
    """Manifest mockup entries with their feature resolved."""
    resolved = []
    for key, entry in sorted((manifest.get("mockups") or {}).items()):
        if not isinstance(entry, dict):
            continue
        resolved.append(
            {
                "key": key,
                "artboard": entry.get("artboard", ""),
                "screen": entry.get("screen", ""),
                "feature": resolve_feature(entry, fsd_map, sections),
            }
        )
    return resolved


def artboard_links(mockups_dir):
    """(src, dst) .dc.html pairs from <a href> inside artboard files, in
    deterministic order; external and protocol-relative URLs never become
    arrows, and a fragment/query on a href is stripped before matching."""
    links = []
    for path in sorted(mockups_dir.glob("*.dc.html")):
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            continue
        for href in LINK_RES.findall(text):
            if re.match(r"^https?://", href, re.IGNORECASE) or href.startswith("//"):
                continue
            dst = href.rsplit("/", 1)[-1].split("#", 1)[0].split("?", 1)[0]
            if dst.endswith(".dc.html") and dst != path.name:
                links.append((path.name, dst))
    return links


def render_map_view(mockups_dir, canvas, links):
    """map.html: artboard cards absolutely positioned at canvas x/y/w/h per
    feature lane, SVG arrows between placed artboards, and a JSON island
    recording every arrow. Returns {filename: content} to write."""
    features = [f for f in canvas.get("features", []) if isinstance(f, dict)]
    lane_y = {f.get("feature"): f.get("lane", 0) * LANE_HEIGHT for f in features}
    boards = [b for b in canvas.get("artboards", []) if isinstance(b, dict)]
    height = LANE_HEIGHT
    for board in boards:
        y = lane_y.get(board.get("feature"), 0) + board.get("y", 0) + board.get("h", 0)
        height = max(height, y + 40)

    lines = [
        HEADER,
        "<!doctype html>",
        '<html lang="en"><head><meta charset="utf-8"><title>Map</title>',
        "<style>body{font-family:sans-serif;margin:0}"
        f"#canvas{{position:relative;width:100%;height:{height}px}}"
        ".lane{position:absolute;left:1rem;font-weight:bold;color:#666}"
        '.board{position:absolute;border:1px solid #ccc;background:#fff;padding:0.25rem}</style>',
        "</head><body>",
        '<div id="canvas">',
    ]
    for feature in features:
        y = feature.get("lane", 0) * LANE_HEIGHT
        title = feature.get("title") or feature.get("feature", "")
        lines.append(f'<div class="lane" style="top:{y + 8}px">{html.escape(str(title))}</div>')
    for board in sorted(boards, key=lambda b: b.get("file", "")):
        file = board.get("file", "")
        title = board.get("title") or file
        y = lane_y.get(board.get("feature"), 0) + board.get("y", 0)
        lines.append(
            f'<div class="board" style="left:{board.get("x", 0)}px;top:{y}px;'
            f'width:{board.get("w", 0)}px;height:{board.get("h", 0)}px">'
            f'<a href="{html.escape(file, quote=True)}">{html.escape(title)}</a></div>'
        )

    by_file = {b.get("file"): b for b in boards}

    def center(file, axis):
        board = by_file.get(file)
        if board is None:
            return None
        if axis == "x":
            return board.get("x", 0) + board.get("w", 0) // 2
        return lane_y.get(board.get("feature"), 0) + board.get("y", 0) + board.get("h", 0) // 2

    edges = []
    for src, dst in links:
        x1, y1, x2, y2 = (center(src, "x"), center(src, "y"), center(dst, "x"), center(dst, "y"))
        if None not in (x1, y1, x2, y2):
            edges.append((x1, y1, x2, y2, src, dst))
    if edges:
        lines += [
            f'<svg width="100%" height="{height}" style="position:absolute;left:0;top:0;pointer-events:none">',
            '<defs><marker id="arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="6" '
            'markerHeight="6" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#c33"/></marker></defs>',
        ]
        for x1, y1, x2, y2, src, dst in edges:
            lines.append(
                f'<line x1="{x1}" y1="{y1}" x2="{x2}" y2="{y2}" stroke="#c33" '
                f'data-from="{html.escape(src, quote=True)}" data-to="{html.escape(dst, quote=True)}" '
                'marker-end="url(#arrow)"/>'
            )
        lines.append("</svg>")
    lines += [
        "</div>",
        '<script type="application/json" id="map-links">'
        + json.dumps([{"from": src, "to": dst} for src, dst in links])
        + "</script>",
        "</body></html>",
    ]
    return {"map.html": "\n".join(lines) + "\n"}


def write_if_changed(path, content):
    data = content.encode("utf-8")
    if path.exists() and path.read_bytes() == data:
        return
    path.write_bytes(data)


def main(argv):
    parsed = parse_args(argv)
    if parsed is None:
        print(USAGE, file=sys.stderr)
        return 2
    mockups_dir, map_path = parsed

    code, err = run_validation(mockups_dir, map_path)
    if code != 0:
        sys.stderr.write(err)
        return code

    manifest = json.loads((mockups_dir / "mockups.json").read_text(encoding="utf-8"))
    canvas = json.loads((mockups_dir / "canvas.json").read_text(encoding="utf-8"))
    fsd_map = parse_fsd(map_path)
    resolved = resolved_entries(manifest, fsd_map, screen_sections(map_path))
    links = artboard_links(mockups_dir)

    outputs = {
        "index.html": render_index(canvas),
        "MOCKUPS.md": render_mockups_md(manifest),
    }
    outputs.update(render_feature_views(mockups_dir, canvas, resolved))
    outputs.update(render_map_view(mockups_dir, canvas, links))
    for name, content in sorted(outputs.items()):
        target = mockups_dir / name
        target.parent.mkdir(parents=True, exist_ok=True)
        write_if_changed(target, content)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
