#!/usr/bin/env bash
# Bootstraps a fresh laptop: system deps, npm install and the Claude Code link.
# Idempotent: rerun is safe. OpenViking memory was retired (option C, ADR-005);
# its data stays in ~/.openviking until removed by hand.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"

step() { printf '\n== %s\n' "$1"; }
die() { printf 'bootstrap: %s\n' "$1" >&2; exit 1; }

step "system deps"
have() { command -v "$1" >/dev/null 2>&1; }

have curl || die "curl not found (macOS ships it)"
have git || die "git not found, install git"

if ! have brew; then
  [ "$(uname -s)" = "Darwin" ] || die "brew missing and this setup is macOS-specific"
  echo "installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
    || die "Homebrew install failed"
  # Apple Silicon; Intel brew lives in /usr/local which is already on PATH.
  [ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
  have brew || die "brew is still not on PATH after install"
fi

if ! have node; then
  echo "installing node (brew)"
  brew install --formula node
fi
if ! have python3; then
  echo "installing python (brew)"
  brew install --formula python
fi
if ! have opencode; then
  echo "installing opencode (official installer)"
  curl -fsSL https://opencode.ai/install | bash
  export PATH="$HOME/.opencode/bin:$PATH"
  have opencode || die "opencode is still not on PATH after install"
fi

step "npm install"
(cd "$REPO" && npm install --no-fund --no-audit)

step "GLM token for opencode"
auth_file="$HOME/.local/share/opencode/auth.json"
zai_key="$(python3 -c 'import json,sys; p=sys.argv[1]; d=json.load(open(p)) if p and __import__("os").path.exists(p) else {}; print((d.get("zai-coding-plan") or {}).get("key",""))' "$auth_file" 2>/dev/null || true)"
if [ -n "$zai_key" ]; then
  echo "keeping the existing GLM (zai-coding-plan) key"
else
  printf 'GLM token for opencode, z.ai coding plan (input hidden): '
  read -rs glm_key
  echo
  if [ -n "$glm_key" ]; then
    umask 077
    python3 - "$auth_file" "$glm_key" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
data = json.loads(path.read_text()) if path.exists() else {}
entry = data.get("zai-coding-plan") or {}
entry.update({"type": "api", "key": sys.argv[2]})
data["zai-coding-plan"] = entry
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(json.dumps(data, indent=2) + "\n")
path.chmod(0o600)
PY
    unset glm_key
    echo "GLM key saved to $auth_file"
  else
    echo "no GLM token entered, skip (opencode auth login can add it later)"
  fi
fi

mkdir -p "$HOME/specs"

step "DEEPSEEK key for the deepseek provider (optional)"
env_file="$REPO/.env"
have_key() { grep -qE '^DEEPSEEK_API_KEY=.' "$env_file" 2>/dev/null; }
if [ -n "${DEEPSEEK_API_KEY:-}" ] || have_key; then
  echo "keeping the existing DEEPSEEK_API_KEY"
elif [ -f "$HOME/.openviking/.env" ] && grep -qE '^DEEPSEEK_API_KEY=.' "$HOME/.openviking/.env"; then
  umask 077
  grep '^DEEPSEEK_API_KEY=' "$HOME/.openviking/.env" >> "$env_file"
  chmod 600 "$env_file"
  echo "moved DEEPSEEK_API_KEY from the retired ~/.openviking/.env"
else
  printf 'DEEPSEEK_API_KEY (input hidden, empty = skip, add later to %s): ' "$env_file"
  read -rs deepseek_key
  echo
  if [ -n "$deepseek_key" ]; then
    umask 077
    printf 'DEEPSEEK_API_KEY=%s\n' "$deepseek_key" >> "$env_file"
    chmod 600 "$env_file"
    unset deepseek_key
    echo "DEEPSEEK_API_KEY saved to $env_file"
  else
    echo "no DEEPSEEK_API_KEY: the deepseek provider stays disabled until the key is added"
  fi
fi

# Retired OpenViking integration: unload its launch agents and unregister its MCP
# in Claude Code when a memory install left them behind. Data in ~/.openviking
# and the DeepSeek key inside its .env are kept.
LA="$HOME/Library/LaunchAgents"
for target in "$LA/opencode.ov-studio.plist" "$LA/opencode.ov-syncd.plist"; do
  [ -e "$target" ] || continue
  launchctl bootout "gui/$(id -u)/$(basename "$target" .plist)" >/dev/null 2>&1 || true
  rm -f "$target" || die "cannot remove $target"
  echo "removed launch agent $(basename "$target" .plist)"
done
if command -v claude >/dev/null && claude mcp get openviking >/dev/null 2>&1; then
  claude mcp remove openviking -s user >/dev/null 2>&1 || true
  echo "claude: openviking mcp removed"
fi
if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx openviking; then
  docker stop openviking >/dev/null || true
  echo "stopped the openviking container"
fi

step "claude link"
if command -v claude >/dev/null; then
  "$REPO/bin/claude-link"
else
  echo "claude not installed, skipping bin/claude-link"
fi

step "done"
echo "setup ready; memory (OpenViking) is retired — semantic search is git + rg over ~/specs"
