#!/usr/bin/env python3
import subprocess
import sys


def build_command(project):
    return [
        "docker", "exec", "openviking", "ov", "add-resource", f"/specs/{project}",
        "--to", f"viking://resources/{project}/specs",
        "--args", "parse_mode:no_split",
    ]


def sync(project, run=subprocess.run):
    try:
        r = run(build_command(project), capture_output=True, text=True, timeout=600)
    except FileNotFoundError:
        print("ov-sync: docker not installed, skipped")
        return 0
    except subprocess.TimeoutExpired:
        print("ov-sync: docker exec timed out", file=sys.stderr)
        return 1
    if r.returncode != 0:
        sys.stderr.write(r.stderr)
        print(f"ov-sync: docker exec failed with exit {r.returncode}", file=sys.stderr)
        return r.returncode
    print(f"ov-sync: synced viking://resources/{project}/specs")
    return 0


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit("usage: ov-sync <project>")
    sys.exit(sync(sys.argv[1]))
