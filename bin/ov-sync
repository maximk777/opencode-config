#!/usr/bin/env python3
import subprocess
import sys


def build_command(project):
    return [
        "docker", "exec", "openviking", "ov", "add-resource", f"/specs/{project}",
        "--to", f"viking://resources/{project}/specs",
        "--args", "parse_mode:no_split",
    ]


def sync(project, run=subprocess.run):
    try:
        r = run(build_command(project), capture_output=True, text=True, timeout=600)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        print("ov-sync: openviking unavailable, skipped")
        return 0
    if r.returncode != 0:
        print("ov-sync: openviking unavailable, skipped")
        return 0
    print(f"ov-sync: synced viking://resources/{project}/specs")
    return 0


if __name__ == "__main__":
    if len(sys.argv) != 2:
        sys.exit("usage: ov-sync <project>")
    sys.exit(sync(sys.argv[1]))
