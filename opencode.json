{
  "$schema": "https://opencode.ai/config.json",
  "model": "{file:./tiers/fast}",
  "small_model": "{file:./tiers/fast}",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "env": "deny",
      "printenv*": "deny",
      "set": "deny",
      "export -p": "deny",
      "*.env": "deny",
      "*.env *": "deny",
      "opencode debug*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "phase_reset": "deny"
  },
  "provider": {
    "corellm-llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "WB CoreLLM",
      "options": {
        "baseURL": "https://llm.wb.ru/api/v1",
        "apiKey": "{env:CORELLM_TOKEN}"
      },
      "models": {
        "llm-medium": {
          "name": "DeepSeek V4 Flash (CoreLLM)",
          "limit": {
            "context": 256000,
            "output": 16192
          }
        },
        "coder": {
          "name": "GLM-5.3-Flash (CoreLLM)",
          "limit": {
            "context": 262144,
            "output": 8096
          }
        }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek API",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        }
      }
    }
  },
  "agent": {
    "explorer": {
      "mode": "subagent",
      "description": "Read-only code search and reading; returns findings with file paths",
      "model": "{file:./tiers/fast}",
      "prompt": "{file:./prompts/explorer.md}",
      "steps": 30,
      "permission": {
        "edit": "deny",
        "task": "deny",
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git show*": "allow",
          "rg *": "allow",
          "* --output*": "deny",
          "rg *--pre*": "deny",
          "*>*": "deny",
          "env": "deny",
          "printenv*": "deny",
          "set": "deny",
          "export -p": "deny",
          "*.env": "deny",
          "*.env *": "deny"
        },
        "openviking_find": "allow",
        "openviking_search": "allow"
      }
    },
    "web-researcher": {
      "mode": "subagent",
      "description": "Read-only web research: searches the live web, fetches sources, cross-checks, returns cited findings",
      "model": "{file:./tiers/fast}",
      "prompt": "{file:./prompts/web-researcher.md}",
      "steps": 40,
      "permission": {
        "edit": "deny",
        "task": "deny",
        "bash": {
          "*": "deny"
        },
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "ui-designer": {
      "mode": "subagent",
      "description": "Renders and validates screen mockups from a MAP spec using style kits",
      "model": "{file:./tiers/smart}",
      "prompt": "{file:./prompts/ui-designer.md}",
      "steps": 60,
      "permission": {
        "edit": {
          "*": "deny",
          "mockups/**": "allow",
          "**/mockups/**": "allow"
        },
        "task": "deny",
        "bash": {
          "*": "deny",
          "~/.config/opencode/bin/designer-*": "allow",
          "/Users/*/.config/opencode/bin/designer-*": "allow"
        }
      },
      "hidden": false
    },
    "orchestrator": {
      "mode": "primary",
      "description": "Runs one change from brainstorm to archive",
      "model": "{file:./tiers/smart}",
      "prompt": "{file:./prompts/orchestrator.md}",
      "permission": {
        "edit": {
          "*": "deny",
          "../*specs/*": "allow"
        },
        "task": {
          "*": "deny",
          "executor": "allow",
          "executor-strong": "allow",
          "task-reviewer": "allow",
          "explorer": "allow",
          "web-researcher": "allow"
        },
        "bash": {
          "*": "allow",
          "git commit*": "ask",
          "git * commit*": "ask",
          "git push*": "ask",
          "git * push*": "ask",
          "env": "deny",
          "printenv*": "deny",
          "set": "deny",
          "export -p": "deny",
          "*.env": "deny",
          "*.env *": "deny",
          "opencode debug*": "deny"
        },
        "phase_reset": "allow",
        "todowrite": "allow"
      }
    },
    "executor": {
      "mode": "subagent",
      "hidden": true,
      "description": "Implements one task from a brief file",
      "model": "{file:./tiers/fast}",
      "prompt": "{file:./prompts/executor.md}",
      "steps": 40,
      "permission": {
        "task": "deny",
        "bash": {
          "*": "allow",
          "env": "deny",
          "printenv*": "deny",
          "set": "deny",
          "export -p": "deny",
          "*.env": "deny",
          "*.env *": "deny",
          "git commit*": "deny",
          "git * commit*": "deny",
          "git push*": "deny",
          "git * push*": "deny"
        },
        "openviking_*": "deny",
        "openviking_find": "allow",
        "openviking_read": "allow",
        "todowrite": "deny"
      }
    },
    "executor-strong": {
      "mode": "subagent",
      "hidden": true,
      "description": "Implements one prose-described or escalated task from a brief file",
      "model": "{file:./tiers/smart}",
      "prompt": "{file:./prompts/executor-strong.md}",
      "steps": 60,
      "permission": {
        "task": "deny",
        "bash": {
          "*": "allow",
          "env": "deny",
          "printenv*": "deny",
          "set": "deny",
          "export -p": "deny",
          "*.env": "deny",
          "*.env *": "deny",
          "git commit*": "deny",
          "git * commit*": "deny",
          "git push*": "deny",
          "git * push*": "deny"
        },
        "openviking_*": "deny",
        "openviking_find": "allow",
        "openviking_read": "allow",
        "todowrite": "deny"
      }
    },
    "task-reviewer": {
      "mode": "subagent",
      "hidden": true,
      "description": "Reviews one task: spec verdict first, quality only when compliant",
      "model": "{file:./tiers/smart}",
      "prompt": "{file:./prompts/task-reviewer.md}",
      "steps": 30,
      "permission": {
        "edit": {
          "*": "deny",
          "../*specs/*/reports/*": "allow"
        },
        "task": "deny",
        "openviking_*": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git show*": "allow",
          "git status*": "allow",
          "go test*": "allow",
          "npm test*": "allow",
          "* --output*": "deny",
          "*>*": "deny",
          "env": "deny",
          "printenv*": "deny",
          "set": "deny",
          "export -p": "deny",
          "*.env": "deny",
          "*.env *": "deny"
        },
        "todowrite": "deny"
      }
    },
    "architect": {
      "mode": "primary",
      "description": "System-level design: ADRs, diagrams, roadmap, proofs of concept, change candidates",
      "model": "{file:./tiers/smart}",
      "prompt": "{file:./prompts/architect.md}",
      "permission": {
        "edit": {
          "*": "deny",
          "../*specs/*/architecture/*": "allow"
        },
        "task": {
          "*": "deny",
          "explorer": "allow",
          "web-researcher": "allow"
        },
        "bash": {
          "*": "allow",
          "git commit*": "deny",
          "git * commit*": "deny",
          "git push*": "deny",
          "git * push*": "deny",
          "env": "deny",
          "printenv*": "deny",
          "set": "deny",
          "export -p": "deny",
          "*.env": "deny",
          "*.env *": "deny",
          "opencode debug*": "deny"
        },
        "phase_reset": "allow"
      }
    },
    "harness-builder": {
      "mode": "primary",
      "description": "Measures a service's error background and designs evidence-backed quality gates",
      "model": "{file:./tiers/smart}",
      "prompt": "{file:./prompts/harness-builder.md}",
      "permission": {
        "edit": {
          "*": "deny",
          "../*specs/*/harness/*": "allow"
        },
        "task": {
          "*": "deny",
          "explorer": "allow"
        },
        "bash": {
          "*": "allow",
          "git commit*": "deny",
          "git * commit*": "deny",
          "git push*": "deny",
          "git * push*": "deny",
          "env": "deny",
          "printenv*": "deny",
          "set": "deny",
          "export -p": "deny",
          "*.env": "deny",
          "*.env *": "deny",
          "opencode debug*": "deny"
        }
      }
    },
    "instrumentation": {
      "mode": "primary",
      "description": "Builds and audits project agent instrumentation: AGENTS.md, .agents rules, skills and agents",
      "model": "{file:./tiers/smart}",
      "prompt": "{file:./prompts/instrumentation.md}",
      "permission": {
        "edit": {
          "*": "deny",
          "AGENTS.md": "allow",
          ".agents/*": "allow",
          ".opencode/*": "allow"
        },
        "task": {
          "*": "deny",
          "explorer": "allow"
        },
        "bash": {
          "*": "allow",
          "git commit*": "deny",
          "git * commit*": "deny",
          "git push*": "deny",
          "git * push*": "deny",
          "env": "deny",
          "printenv*": "deny",
          "set": "deny",
          "export -p": "deny",
          "*.env": "deny",
          "*.env *": "deny",
          "opencode debug*": "deny"
        }
      }
    },
    "workspace-builder": {
      "mode": "primary",
      "description": "Creates and extends team workspaces from the workspace kit",
      "model": "{file:./tiers/smart}",
      "prompt": "{file:./prompts/workspace-builder.md}",
      "permission": {
        "edit": {
          "*": "allow",
          "*.env": "deny",
          "*/.env": "deny",
          "*/.env.*": "deny",
          ".env": "deny",
          ".env.*": "deny",
          "*.env.example": "allow",
          "~/.config/opencode/*": "deny",
          "?/.config/opencode/*": "deny",
          "*/.config/opencode/*": "deny"
        },
        "task": {
          "*": "deny",
          "explorer": "allow"
        },
        "bash": {
          "*": "allow",
          "git commit*": "deny",
          "git * commit*": "deny",
          "git push*": "deny",
          "git * push*": "deny",
          "env": "deny",
          "printenv*": "deny",
          "set": "deny",
          "export -p": "deny",
          "*.env": "deny",
          "*.env *": "deny",
          "opencode debug*": "deny"
        }
      }
    },
    "setup-improver": {
      "mode": "primary",
      "description": "Audits and improves the global OpenCode setup: config drift, upstream sources, flow metrics",
      "model": "{file:./tiers/smart}",
      "prompt": "{file:./prompts/setup-improver.md}",
      "permission": {
        "edit": {
          "*": "allow",
          "../*": "deny"
        },
        "task": {
          "*": "deny",
          "explorer": "allow"
        },
        "bash": {
          "*": "allow",
          "git * commit*": "deny",
          "git push*": "deny",
          "git * push*": "deny",
          "env": "deny",
          "printenv*": "deny",
          "set": "deny",
          "export -p": "deny",
          "*.env": "deny",
          "*.env *": "deny",
          "opencode debug*": "deny"
        }
      }
    }
  },
  "mcp": {
    "openviking": {
      "type": "remote",
      "url": "http://127.0.0.1:1933/mcp",
      "headers": {
        "Authorization": "Bearer {file:~/.openviking/mcp-key}"
      },
      "enabled": true,
      "oauth": false
    }
  },
  "lsp": true,
  "plugin": [
    "./plugins/session-reset.mjs"
  ]
}
