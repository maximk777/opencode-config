{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow"
  },
  "provider": {
    "corellm-llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "WB CoreLLM",
      "options": {
        "baseURL": "https://llm.wb.ru/api/v1",
        "apiKey": "{env:CORELLM_TOKEN}"
      },
      "models": {
        "llm-medium": {
          "name": "DeepSeek V4 Flash (CoreLLM)",
          "limit": {
            "context": 256000,
            "output": 16192
          }
        },
        "coder": {
          "name": "GLM-5.3-Flash (CoreLLM)",
          "limit": {
            "context": 262144,
            "output": 8096
          }
        }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek API",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        }
      }
    }
  },
  "agent": {
    "explorer": {
      "mode": "subagent",
      "description": "Read-only code search and reading; returns findings with file paths",
      "model": "{file:./tiers/fast}",
      "prompt": "{file:./prompts/explorer.md}",
      "steps": 30,
      "permission": {
        "edit": "deny",
        "task": "deny",
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git show*": "allow",
          "rg *": "allow"
        }
      }
    },
    "orchestrator": {
      "mode": "primary",
      "description": "Runs one change from brainstorm to archive",
      "model": "{file:./tiers/smart}",
      "prompt": "{file:./prompts/orchestrator.md}",
      "permission": {
        "edit": {
          "*": "deny",
          "*specs/*": "allow"
        },
        "task": {
          "*": "deny",
          "executor": "allow",
          "executor-strong": "allow",
          "task-reviewer": "allow",
          "explorer": "allow"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git add -- *": "allow",
          "git -C *": "allow",
          "git commit*": "deny",
          "git push*": "deny",
          "openspec *": "allow",
          "mkdir *": "allow",
          "*/bin/waves *": "allow",
          "*/bin/change-state *": "allow",
          "*/bin/check-commit-msg*": "allow"
        }
      }
    },
    "executor": {
      "mode": "subagent",
      "hidden": true,
      "description": "Implements one task from a brief file",
      "model": "{file:./tiers/fast}",
      "prompt": "{file:./prompts/executor.md}",
      "steps": 40,
      "permission": {
        "task": "deny",
        "bash": {
          "*": "allow",
          "git commit*": "deny",
          "git push*": "deny"
        },
        "openviking_*": "deny",
        "openviking_find": "allow",
        "openviking_read": "allow"
      }
    },
    "executor-strong": {
      "mode": "subagent",
      "hidden": true,
      "description": "Implements one prose-described or escalated task from a brief file",
      "model": "{file:./tiers/smart}",
      "prompt": "{file:./prompts/executor-strong.md}",
      "steps": 60,
      "permission": {
        "task": "deny",
        "bash": {
          "*": "allow",
          "git commit*": "deny",
          "git push*": "deny"
        },
        "openviking_*": "deny",
        "openviking_find": "allow",
        "openviking_read": "allow"
      }
    },
    "task-reviewer": {
      "mode": "subagent",
      "hidden": true,
      "description": "Reviews one task: spec verdict first, quality only when compliant",
      "model": "{file:./tiers/smart}",
      "prompt": "{file:./prompts/task-reviewer.md}",
      "steps": 30,
      "permission": {
        "edit": {
          "*": "deny",
          "*reports/*": "allow"
        },
        "task": "deny",
        "openviking_*": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git show*": "allow",
          "go test*": "allow",
          "npm test*": "allow"
        }
      }
    },
    "architect": {
      "mode": "primary",
      "description": "System-level design: ADRs, diagrams, roadmap, proofs of concept, change candidates",
      "model": "{file:./tiers/smart}",
      "prompt": "{file:./prompts/architect.md}",
      "permission": {
        "edit": {
          "*": "deny",
          "*specs/*/architecture/*": "allow"
        },
        "task": {
          "*": "deny",
          "explorer": "allow"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git -C *": "allow",
          "git commit*": "deny",
          "git push*": "deny",
          "mkdir *": "allow",
          "git worktree add*": "allow",
          "git worktree remove*": "allow",
          "docker compose *": "allow",
          "docker run *": "ask",
          "go *": "allow",
          "python3 *": "allow",
          "node *": "allow",
          "*/bin/ov-sync *": "allow"
        }
      }
    },
    "harness-builder": {
      "mode": "primary",
      "description": "Measures a service's error background and designs evidence-backed quality gates",
      "model": "{file:./tiers/smart}",
      "prompt": "{file:./prompts/harness-builder.md}",
      "permission": {
        "edit": {
          "*": "deny",
          "*specs/*/harness/*": "allow",
          "*.harness-probe-*": "allow"
        },
        "task": {
          "*": "deny",
          "explorer": "allow"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git -C *": "allow",
          "git worktree add*": "allow",
          "git worktree remove*": "allow",
          "docker compose *": "allow",
          "go test*": "allow",
          "npm test*": "allow",
          "mkdir *": "allow",
          "*/bin/error-background *": "allow",
          "*/bin/ov-sync *": "allow",
          "git commit*": "deny",
          "git push*": "deny"
        }
      }
    }
  }
}
