{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "phase_reset": "deny"
  },
  "provider": {
    "corellm-llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "WB CoreLLM",
      "options": {
        "baseURL": "https://llm.wb.ru/api/v1",
        "apiKey": "{env:CORELLM_TOKEN}"
      },
      "models": {
        "llm-medium": {
          "name": "DeepSeek V4 Flash (CoreLLM)",
          "limit": {
            "context": 256000,
            "output": 16192
          }
        },
        "coder": {
          "name": "GLM-5.3-Flash (CoreLLM)",
          "limit": {
            "context": 262144,
            "output": 8096
          }
        }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek API",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        }
      }
    }
  },
  "agent": {
    "explorer": {
      "mode": "subagent",
      "description": "Read-only code search and reading; returns findings with file paths",
      "model": "{file:./tiers/fast}",
      "prompt": "{file:./prompts/explorer.md}",
      "steps": 30,
      "permission": {
        "edit": "deny",
        "task": "deny",
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git show*": "allow",
          "rg *": "allow",
          "* --output*": "deny",
          "rg *--pre*": "deny",
          "*>*": "deny",
          "env": "deny",
          "printenv*": "deny",
          "set": "deny",
          "export -p": "deny",
          "*.env": "deny",
          "*.env *": "deny"
        }
      }
    },
    "orchestrator": {
      "mode": "primary",
      "description": "Runs one change from brainstorm to archive",
      "model": "{file:./tiers/smart}",
      "prompt": "{file:./prompts/orchestrator.md}",
      "permission": {
        "edit": {
          "*": "deny",
          "../*specs/*": "allow"
        },
        "task": {
          "*": "deny",
          "executor": "allow",
          "executor-strong": "allow",
          "task-reviewer": "allow",
          "explorer": "allow"
        },
        "bash": {
          "*": "ask",
          "read *": "allow",
          "IFS= read *": "allow",
          "command -v *": "allow",
          "type *": "allow",
          "which *": "allow",
          "sort*": "allow",
          "uniq*": "allow",
          "cut *": "allow",
          "tr *": "allow",
          "jq *": "allow",
